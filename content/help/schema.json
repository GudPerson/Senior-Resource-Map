{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.carearound.sg/schemas/help-article.json",
  "title": "CareAround reviewed help article",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "category",
    "audiences",
    "visibility",
    "status",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HC-[0-9]{2,3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 1
    },
    "visibility": {
      "enum": [
        "public",
        "signed-in",
        "resource-manager",
        "organization",
        "admin",
        "support-review",
        "audit"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "date",
        "sourceRevision",
        "method",
        "owner",
        "evidence"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "minItems": 1
        }
      }
    },
    "relatedArticleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^HC-[0-9]{2,3}$"
      },
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "facts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "keywords",
                "route",
                "evidence",
                "reviewed"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  },
                  "minItems": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "route": {
                  "type": "string",
                  "pattern": "^/(?!/)"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "reviewed": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "queryRequiresAny": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                  }
                },
                "answerKind": {
                  "enum": [
                    "procedure"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "answerKind": {
                        "const": "procedure"
                      }
                    },
                    "required": [
                      "answerKind"
                    ]
                  },
                  "else": {
                    "required": [
                      "message"
                    ]
                  }
                }
              ]
            }
          },
          "queryRequiresAny": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    }
  ],
  "$comment": "scripts/build-help-content.mjs enforces cross-file identity, section uniqueness, related-link visibility, legacy fact mapping, evidence and procedure steps. Draft/retired records are excluded from delivery."
}
