# Local development can keep the default relative /api base because Vite proxies
# requests to the local API server.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_URL=/api

# Owner Detailed map. Keep the activation flag and both interactive roots
# together: omitting them compiles the Detailed control out of the client as
# an intentional rollback.
VITE_TOWN_MAP_PROOF_ENABLED=
VITE_TOWN_MAP_ASSET_BASE_URL=
VITE_TOWN_MAP_GRAY_ASSET_BASE_URL=

# Print-only 100% fixed-surface roots. Production release validation requires
# both; the files load only when an owner chooses "Save print master PDF".
VITE_TOWN_MAP_PRINT_MASTER_ASSET_BASE_URL=
VITE_TOWN_MAP_GRAY_PRINT_MASTER_ASSET_BASE_URL=

# For Cloudflare Pages production deploys, export VITE_API_URL in the shell
# before running npm run deploy:client, for example:
# export VITE_API_URL="https://senior-resource-map-api.<subdomain>.workers.dev/api"
