{
  "name": "seniorcare-connect",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client -- --host localhost --port 5173",
    "dev:server": "npm run dev:worker --workspace=server",
    "dev:server:node": "npm run dev:node --workspace=server",
    "dev:town-map-assets": "node scripts/town-map/serve-w01-assets.mjs",
    "dev:islandwide-town-map-assets": "node scripts/town-map/serve-islandwide-assets.mjs",
    "town-map:manifest": "node scripts/town-map/generate-w01-manifest.mjs",
    "town-map:gray:manifest": "node scripts/town-map/generate-w01-gray-manifest.mjs",
    "town-map:islandwide:manifest": "node scripts/town-map/generate-islandwide-manifests.mjs",
    "town-map:islandwide:r2:plan": "node scripts/town-map/upload-islandwide-r2.mjs",
    "town-map:islandwide:r2:upload": "node scripts/town-map/upload-islandwide-r2.mjs --apply",
    "town-map:islandwide:r2:verify": "node scripts/town-map/verify-islandwide-r2.mjs",
    "town-map:islandwide:gray:r2:plan": "node scripts/town-map/upload-islandwide-r2.mjs --style=gray",
    "town-map:islandwide:gray:r2:upload": "node scripts/town-map/upload-islandwide-r2.mjs --style=gray --apply",
    "town-map:islandwide:gray:r2:verify": "node scripts/town-map/verify-islandwide-r2.mjs --style=gray",
    "town-map:r2:plan": "node scripts/town-map/upload-w01-r2.mjs",
    "town-map:r2:upload": "node scripts/town-map/upload-w01-r2.mjs --apply",
    "town-map:r2:verify": "node scripts/town-map/verify-w01-r2.mjs",
    "town-map:gray:r2:plan": "node scripts/town-map/upload-w01-r2.mjs --style=gray",
    "town-map:gray:r2:upload": "node scripts/town-map/upload-w01-r2.mjs --style=gray --apply",
    "town-map:gray:r2:verify": "node scripts/town-map/verify-w01-r2.mjs --style=gray",
    "town-map:r2:test": "node --test scripts/town-map/*.test.mjs",
    "build:client": "npm run build --workspace=client",
    "build:cloudflare": "npm run build:client",
    "deploy:client": "node scripts/validate-cloudflare-client-env.mjs && npm run build --workspace=client && cd client && npx wrangler pages deploy dist --project-name senior-resource-map",
    "deploy:server": "npm run deploy --workspace=server",
    "test:server": "npm run test --workspace=server",
    "test:smoke:install-browser": "npx playwright install chromium",
    "test:smoke": "npx playwright test --config=playwright.smoke.config.mjs",
    "verify:release": "npm run test:server && npm run build:client && npm run test:smoke",
    "audit:db-fingerprint": "npm run audit:db-fingerprint --workspace=server",
    "audit:clean-slate": "node --env-file=server/.env server/scripts/audit_clean_slate.js",
    "reset:clean-slate": "node --env-file=server/.env server/scripts/reset_clean_slate.js"
  },
  "devDependencies": {
    "playwright": "^1.54.2"
  }
}
