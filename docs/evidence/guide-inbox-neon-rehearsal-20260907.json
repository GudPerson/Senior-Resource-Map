  "preflightSql": "-- CareAround schema-only Neon rehearsal preflight; catalog and aggregate counts only\nBEGIN READ ONLY;\nSET LOCAL statement_timeout = '10s';\nSET LOCAL lock_timeout = '2s';\n\nWITH table_fingerprints AS (\n  SELECT c.relname AS name, c.relkind::text AS kind, c.relrowsecurity AS rls, c.relforcerowsecurity AS force_rls,\n    (SELECT count(*)::int FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped) AS columns_count,\n    (SELECT md5(coalesce(jsonb_agg(jsonb_build_array(a.attname,format_type(a.atttypid,a.atttypmod),a.attnotnull,coalesce(pg_get_expr(d.adbin,d.adrelid),''),a.attidentity,a.attgenerated) ORDER BY a.attname)::text,'[]'))\n     FROM pg_attribute a LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum\n     WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped) AS columns_hash,\n    (SELECT count(*)::int FROM pg_constraint k WHERE k.conrelid=c.oid AND k.contype <> 'n') AS constraints_count,\n    (SELECT md5(coalesce(jsonb_agg(jsonb_build_array(k.conname,k.contype,pg_get_constraintdef(k.oid,true),k.convalidated,k.condeferrable,k.condeferred) ORDER BY k.conname)::text,'[]'))\n     FROM pg_constraint k WHERE k.conrelid=c.oid AND k.contype <> 'n') AS constraints_hash,\n    (SELECT count(*)::int FROM pg_indexes i WHERE i.schemaname='public' AND i.tablename=c.relname) AS indexes_count,\n    (SELECT md5(coalesce(jsonb_agg(jsonb_build_array(i.indexname,i.indexdef) ORDER BY i.indexname)::text,'[]'))\n     FROM pg_indexes i WHERE i.schemaname='public' AND i.tablename=c.relname) AS indexes_hash\n  FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace\n  WHERE n.nspname='public' AND c.relkind IN ('r','p')\n), enum_values AS (\n SELECT t.typname AS name, jsonb_agg(e.enumlabel ORDER BY e.enumsortorder) AS labels\n FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace JOIN pg_enum e ON e.enumtypid=t.oid\n WHERE n.nspname='public' GROUP BY t.typname\n)\nSELECT jsonb_build_object(\n 'database',current_database(),\n 'read_only',current_setting('transaction_read_only'),\n 'tables',(SELECT coalesce(jsonb_agg(to_jsonb(f) ORDER BY f.name),'[]'::jsonb) FROM table_fingerprints f),\n 'enums',(SELECT coalesce(jsonb_agg(to_jsonb(e) ORDER BY e.name),'[]'::jsonb) FROM enum_values e),\n 'migration_tables',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'table',c.relname) ORDER BY n.nspname,c.relname),'[]'::jsonb)\n  FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','p') AND n.nspname NOT IN ('pg_catalog','information_schema')\n  AND (c.relname ILIKE '%migration%' OR n.nspname='drizzle'))\n) AS carearound_schema_preflight;\nSELECT jsonb_build_object(\n 'database',current_database(),'role',current_user,'server_version',current_setting('server_version'),\n 'branch_setting',current_setting('neon.branch_id',true),'endpoint_setting',current_setting('neon.endpoint_id',true),\n 'public_create',has_schema_privilege(current_user,'public','CREATE'),\n 'users_privileges',has_table_privilege(current_user,'public.users','SELECT,INSERT,UPDATE,DELETE,REFERENCES'),\n 'favorites_privileges',has_table_privilege(current_user,'public.user_favorites','SELECT,INSERT,UPDATE,DELETE,REFERENCES'),\n 'users_count',(SELECT count(*) FROM public.users),\n 'favorites_count',(SELECT count(*) FROM public.user_favorites),\n 'places_count',(SELECT count(*) FROM public.hard_assets),\n 'offerings_count',(SELECT count(*) FROM public.soft_assets),\n 'maps_count',(SELECT count(*) FROM public.my_maps),\n 'noninternal_triggers',(SELECT count(*) FROM pg_trigger tg JOIN pg_class c ON c.oid=tg.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT tg.tgisinternal),\n 'rls_policies',(SELECT count(*) FROM pg_policies WHERE schemaname='public'),\n 'public_functions',(SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public'),\n 'default_acl',(SELECT coalesce(jsonb_agg(jsonb_build_object('role',r.rolname,'schema',n.nspname,'type',d.defaclobjtype,'acl',d.defaclacl::text)),'[]'::jsonb) FROM pg_default_acl d JOIN pg_roles r ON r.oid=d.defaclrole LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace)\n) AS rehearsal_environment;\nROLLBACK;",
