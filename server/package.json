{
  "name": "seniorcare-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:node",
    "dev:node": "node --env-file=.env --watch src/index.js",
    "predev:node": "node ../scripts/build-help-content.mjs --check",
    "dev:worker": "npx wrangler dev --config wrangler.toml --local",
    "predev:worker": "node ../scripts/build-help-content.mjs --check",
    "dev:worker:local": "npx wrangler dev --config wrangler.toml --local --var NODE_ENV:development",
    "predev:worker:local": "node ../scripts/build-help-content.mjs --check",
    "deploy": "node ../scripts/deploy-worker-release.mjs",
    "predeploy": "node ../scripts/build-help-content.mjs --check",
    "bootstrap:boundary-schema": "node --env-file=.env scripts/bootstrap_boundary_schema.js",
    "bootstrap:map-embed-schema": "node --env-file=.env scripts/bootstrap_map_embed_schema.js",
    "bootstrap:map-studio-schema": "node --env-file=.env scripts/bootstrap_map_studio_schema.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "verify:migrations": "node scripts/validate_schema_migrations.mjs",
    "backfill:soft-buckets": "node scripts/backfill_soft_asset_buckets.js",
    "backfill:external-keys": "node scripts/backfill_external_keys.js",
    "backfill:phone-identities": "node --env-file=.env scripts/backfill_phone_identities.js",
    "audit:db-fingerprint": "node --env-file=.env scripts/audit_db_fingerprint.js",
    "audit:phone-identities": "node --env-file=.env scripts/audit_phone_identities.js",
    "audit:clean-slate": "node --env-file=.env scripts/audit_clean_slate.js",
    "reset:clean-slate": "node --env-file=.env scripts/reset_clean_slate.js",
    "start": "node src/index.js",
    "prestart": "node ../scripts/build-help-content.mjs --check",
    "pretest": "node ../scripts/build-help-content.mjs --check",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@hono/node-server": "^1.19.17",
    "@neondatabase/serverless": "^0.9.5",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.12.34",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-kit": "^0.21.4"
  }
}
